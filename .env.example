# ── LLM ────────────────────────────────────────────────────────────────

# OpenAI-compatible LLM proxy (model id without "openai/" prefix)
LLM_BASE_URL=https://llm-proxy.cenario.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Prompt caching via cache_control breakpoints (the proxy only reads its cache with them). Set false for gateways that reject it.
LLM_PROMPT_CACHE=true

# ── Google APIs ────────────────────────────────────────────────────────
# One key with PageSpeed Insights API + Chrome UX Report API enabled
GOOGLE_API_KEY=

# ── Agent limits ───────────────────────────────────────────────────────
# Optional: read-only token for private GitHub repos linked as source (fine-grained, Contents: read)
GITHUB_TOKEN=

AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_TOTAL_TOKENS=400000
TOOL_TIMEOUT_MS=90000
LOG_LEVEL=info

# Browser session tool: Chrome executable (default: installed Google Chrome)
CHROME_PATH=

# RUM collector (POST /api/rum): public project keys -> allowed site hosts. Empty = collector off.
# RUM_KEYS=pk_live_abc123=example.com|shop.example.com
RUM_KEYS=
RUM_DATA_DIR=data/rum
# Public HTTPS address of this server as seen by site visitors (deployment or tunnel), used in the install snippet.
RUM_PUBLIC_URL=

# Web UI (npm run dev)
HOST=127.0.0.1
PORT=3000
