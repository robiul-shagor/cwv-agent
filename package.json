{
  "name": "cwv-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that diagnoses and fixes Core Web Vitals (LCP, INP, CLS) issues",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/api/index.ts",
    "start": "tsx src/api/index.ts",
    "diagnose": "tsx src/cli/diagnose.ts",
    "build:rum": "tsx scripts/build-rum.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.rum.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:rum"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-html-parser": "^9.0.4",
    "playwright-core": "1.63.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
